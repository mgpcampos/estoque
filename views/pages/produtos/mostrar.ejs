<%- include('../../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Detalhes do Produto</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9"><%= produto.id %></dd>
                    
                    <dt class="col-sm-3">Nome</dt>
                    <dd class="col-sm-9"><%= produto.nome %></dd>
                    
                    <dt class="col-sm-3">Quantidade</dt>
                    <dd class="col-sm-9"><%= produto.quantidade %></dd>
                    
                    <dt class="col-sm-3">Categoria</dt>
                    <dd class="col-sm-9"><%= produto.categoria ? produto.categoria.nome : 'Sem categoria' %></dd>
                </dl>
                
                <div class="d-flex justify-content-between mt-4">
                    <a href="/produtos" class="btn btn-secondary">Voltar</a>
                    <div>
                        <a href="/produtos/<%= produto.id %>/editar" class="btn btn-warning">Editar</a>
                        <form action="/produtos/<%= produto.id %>?_method=DELETE" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Tem certeza que deseja excluir este produto?')">Excluir</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>
