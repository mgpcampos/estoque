<%- include('../../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Editar Produto</h4>
            </div>
            <div class="card-body">
                <% if (erro) { %>
                    <div class="alert alert-danger"><%= erro %></div>
                <% } %>
                
                <form action="/produtos/<%= produto.id %>?_method=PUT" method="POST">
                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome</label>
                        <input type="text" class="form-control" id="nome" name="nome" value="<%= produto.nome %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="quantidade" class="form-label">Quantidade</label>
                        <input type="number" class="form-control" id="quantidade" name="quantidade" value="<%= produto.quantidade %>" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label for="categoria_id" class="form-label">Categoria</label>
                        <select class="form-select" id="categoria_id" name="categoria_id" required>
                            <option value="">Selecione uma categoria</option>
                            <% categorias.forEach(categoria => { %>
                                <option value="<%= categoria.id %>" <%= produto.categoria_id == categoria.id ? 'selected' : '' %>><%= categoria.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="/produtos" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-dark">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>
