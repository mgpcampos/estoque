<%- include('../../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Produtos</h1>
    <a href="/produtos/novo" class="btn btn-dark">Novo Produto</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Quantidade</th>
                        <th>Categoria</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (produtos.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center">Nenhum produto cadastrado</td>
                        </tr>
                    <% } else { %>
                        <% produtos.forEach(produto => { %>
                            <tr>
                                <td><%= produto.id %></td>
                                <td><%= produto.nome %></td>
                                <td><%= produto.quantidade %></td>
                                <td><%= produto.categoria ? produto.categoria.nome : 'Sem categoria' %></td>
                                <td>
                                    <a href="/produtos/<%= produto.id %>" class="btn btn-info btn-sm">Ver</a>
                                    <a href="/produtos/<%= produto.id %>/editar" class="btn btn-warning btn-sm">Editar</a>
                                    <form action="/produtos/<%= produto.id %>?_method=DELETE" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Tem certeza que deseja excluir este produto?')">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>
