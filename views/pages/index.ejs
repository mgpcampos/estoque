<%- include('../partials/header') %>

<h1 class="mb-4">Dashboard</h1>

<div class="row">
    <!-- Tabela de Usuários -->
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Usuários</h5>
                <a href="/usuarios" class="btn btn-light btn-sm">Ver Todos</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (usuarios.length === 0) { %>
                                <tr>
                                    <td colspan="2" class="text-center">Nenhum usuário cadastrado</td>
                                </tr>
                            <% } else { %>
                                <% usuarios.forEach(usuario => { %>
                                    <tr>
                                        <td><%= usuario.id %></td>
                                        <td><%= usuario.nome %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Categorias -->
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Categorias</h5>
                <a href="/categorias" class="btn btn-light btn-sm">Ver Todas</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (categorias.length === 0) { %>
                                <tr>
                                    <td colspan="2" class="text-center">Nenhuma categoria cadastrada</td>
                                </tr>
                            <% } else { %>
                                <% categorias.forEach(categoria => { %>
                                    <tr>
                                        <td><%= categoria.id %></td>
                                        <td><%= categoria.nome %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Produtos -->
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Produtos</h5>
                <a href="/produtos" class="btn btn-light btn-sm">Ver Todos</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Quantidade</th>
                                <th>Categoria</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (produtos.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center">Nenhum produto cadastrado</td>
                                </tr>
                            <% } else { %>
                                <% produtos.forEach(produto => { %>
                                    <tr>
                                        <td><%= produto.id %></td>
                                        <td><%= produto.nome %></td>
                                        <td><%= produto.quantidade %></td>
                                        <td><%= produto.categoria ? produto.categoria.nome : 'Sem categoria' %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
